# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- AI proxy ---
# Optional BYOK proxy. The browser supplies the signed-in user's DeepSeek key;
# the proxy must not have a shared provider key.
VITE_AI_PROXY_URL=
# Legacy name still supported for existing deployments.
VITE_GEMINI_PROXY_URL=

# --- Stock quote proxy ---
# Vercel can use the default /api/stock-quotes route.
# GitHub Pages/static hosting needs an external server-side proxy, such as
# workers/stock-quotes-worker.js deployed to Cloudflare Workers.
VITE_STOCK_QUOTE_PROXY_URL=

