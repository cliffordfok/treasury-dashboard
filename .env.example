# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 可選：先在 Firebase App Check 登記 Web App 及 reCAPTCHA Enterprise Key。
# 未設定時不會初始化 App Check；請先監察指標，再另外批准正式 Enforcement。
VITE_FIREBASE_APPCHECK_SITE_KEY=

# --- 本機 Firebase Emulator（只在 npm run dev 生效，Production Build 會忽略）---
# 先另開終端機執行 npm run emulators，再設為 true；毋須填寫上面的 Firebase 設定。
VITE_USE_FIREBASE_EMULATORS=
