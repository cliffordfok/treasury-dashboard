{
  "name": "treasury-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/firestore.rules.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-treasury-dashboard \"vitest run tests/firestore.rules.test.js\"",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.8",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.29.0",
    "globals": "^17.9.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
